{
  "name": "@timebutt/ngx-daterangepicker-material",
  "version": "4.0.5",
  "description": "Angular 2+ date range picker (with material design theme)",
  "keywords": [
    "angular",
    "daterangepicker",
    "material",
    "daterange",
    "picker"
  ],
  "homepage": "https://github.com/Timebutt/ngx-daterangepicker-material",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "schematics": "./schematics/collection.json",
  "scripts": {
    "ng": "ng",
    "start": "npm run build-themes && ng serve",
    "deploy": "ng deploy",
    "demo:build": "ng build --prod",
    "test": "./node_modules/.bin/ng test --watch=false",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "ngc": "./node_modules/.bin/ngc -p tsconfig.json",
    "gh-pages": "ng build --prod --base-href=\"/ngx-daterangepicker-material/\" && ngh --dir demo/dist",
    "build": "ng-packagr -p ng-package.json --config tsconfig.json",
    "build-themes": "bash ./tools/build-themes.sh",
    "build:schematics": "tsc -p ./tsconfig.schematics.json",
    "copy:schematics": "cpr schematics/dist dist/schematics && cp ./schematics/collection.json ./dist/schematics",
    "postbuild": "npm run build:schematics && npm run copy:schematics",
    "prettier": "prettier --write '**/*.{html,js,ts,css,scss,less,md,json}'",
    "prettier-check": "prettier --list-different '**/*.{html,js,ts,css,scss,less,md,json}'"
  },
  "author": "Nils Tijtgat",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timebutt/ngx-daterangepicker-material.git"
  },
  "peerDependencies": {
    "moment": "^2.29.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.11",
    "@angular/animations": "^17.0.8",
    "@angular/cdk": "^17.0.4",
    "@angular/cli": "^16.2.11",
    "@angular/common": "17.0.8",
    "@angular/compiler": "17.0.8",
    "@angular/compiler-cli": "17.0.8",
    "@angular/core": "17.0.8",
    "@angular/forms": "17.0.8",
    "@angular/material": "^17.0.4",
    "@angular/platform-browser": "17.0.8",
    "@angular/platform-browser-dynamic": "17.0.8",
    "@angular/router": "17.0.8",
    "@types/node": "^12.12.34",
    "angular-cli-ghpages": "^0.6.2",
    "core-js": "^2.5.4",
    "cpr": "^3.0.1",
    "moment": "^2.24.0",
    "ng-packagr": "^16.2.3",
    "ngx-highlightjs": "^8.0.0",
    "prettier": "^2.8.4",
    "raw-loader": "^4.0.2",
    "rxjs": "^7.8.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.4.1",
    "tslint": "~5.11.0",
    "typescript": "~5.2.2",
    "zone.js": "~0.14.2"
  }
}